{
  "name": "alright",
  "description": "Alright — a lightweight, local-first personal life app. Android-first, cross-platform.",
  "license": "MIT",
  "version": "2.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.9",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.12",
    "expo-blur": "^57.0.2",
    "expo-constants": "~57.0.10",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-linear-gradient": "^57.0.1",
    "expo-linking": "~57.0.5",
    "expo-notifications": "^57.0.11",
    "expo-router": "~57.0.12",
    "expo-sharing": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ]
  }
}
